# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/prepai?retryWrites=true&w=majority

# Server
PORT=3000
# Use "production" when deployed — enables combined request logs, generic
# (non-verbose) error responses, and is required for the CLIENT_ORIGIN
# misconfiguration warning below to fire correctly.
NODE_ENV=development

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Comma separated list of allowed frontend origins (for CORS in production)
CLIENT_ORIGIN=http://localhost:5173

# ───────────────────────────── Gemini AI ─────────────────────────────
# Google Gemini API key (https://aistudio.google.com/apikey).
# The app works WITHOUT a key too — it then runs entirely on the built-in Smart Engine.
GEMINI_API_KEY=your-gemini-api-key

# ──────────── Optional: resilience tuning (sensible defaults built in) ────────────
# Extra keys are rotated automatically when one hits its rate limit (comma separated).
# GEMINI_API_KEYS=key_one,key_two
# Models tried in order; the app switches to the next on 429/503/404.
# GEMINI_MODELS=gemini-flash-latest,gemini-2.5-flash,gemini-flash-lite-latest,gemini-2.5-flash-lite
# AI_TIMEOUT_MS=25000            # per attempt
# AI_TOTAL_BUDGET_MS=45000       # max time spent on one request before using the Smart Engine
# AI_RETRIES_PER_MODEL=2
# AI_MAX_CONCURRENCY=4           # simultaneous Gemini calls
# AI_CACHE_TTL_MS=1800000        # 30 min response cache
# AI_CIRCUIT_THRESHOLD=3         # consecutive failed requests before the circuit opens
# AI_CIRCUIT_COOLDOWN_MS=30000   # first cooldown (doubles per trip, max 5 min)
# AI_DISABLED=false              # true = force the Smart Engine (handy for offline demos)
