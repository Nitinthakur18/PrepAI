# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/prepai?retryWrites=true&w=majority

# Server
PORT=3000
# Use "production" when deployed — enables combined request logs, generic
# (non-verbose) error responses, and is required for the CLIENT_ORIGIN
# misconfiguration warning below to fire correctly.
NODE_ENV=development

# Auth
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key

# Comma separated list of allowed frontend origins (for CORS in production)
CLIENT_ORIGIN=http://localhost:5173
